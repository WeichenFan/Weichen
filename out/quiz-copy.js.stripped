  "zh-Hans": {
    "ui": {
      "kicker": "四项属性，一次检定",
      "lede": "十道题，问的都是读博里没人写进培养方案的那部分。",
      "begin": "[ 开始 ]",
      "count": "第 %n 题 · 共 %t 题",
      "back": "[ 上一题 ]",
      "best": "状态好的时候",
      "worst": "状态差的时候",
      "attrs": "你的属性",
      "again": "[ 再测一次 ]",
      "title": "你是哪一种博士？",
      "rail": "检定",
      "note": "灵感来自《极乐迪斯科》。如果你觉得像你上周的组会，那不是巧合。",
      "backLink": "← 回到正经履历",
      "gloss": "脑子 · 心态 · 肝 · 手速",
      "langLabel": "语言",
