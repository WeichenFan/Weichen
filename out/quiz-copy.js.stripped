    "dims": {
      "intellect": {
        "name": "脑子",
        "line": "用来跟审稿人吵架的那部分。"
      },
      "psyche": {
        "name": "心态",
        "line": "决定你今年会不会崩。"
      },
      "physique": {
        "name": "肝",
        "line": "你还能熬几个通宵。"
      },
      "motorics": {
        "name": "手速",
        "line": "真正干活的是这双手。"
      }
    },
    "skills": {
      "ablation": {
        "name": "消融",
        "tag": "删掉一个模块，看掉几个点。",
        "body": "结果没被你亲手拆过，你就不信。你发出去的每一个说法，背后都有一张表压着，那张表是你自己一行一行跑出来的。",
        "best": "没有一个数字是你解释不清的。",
        "worst": "都第六周了，你还在删模块。"
      },
      "related-work": {
        "name": "文献雷达",
        "tag": "这事 2017 年有人做过。你还记得是谁。",
        "body": "你对文献不是靠搜，是条件反射。审稿人准备甩给你的那篇，你早读过了，连它悄悄抄的那篇更老的你也读过。",
        "best": "你不会重复造轮子。",
        "worst": "什么 idea 你都能自己把自己劝退，因为总有人已经做得差不多了。"
      },
      "rebuttal": {
        "name": "小作文",
        "tag": "Reviewer 2 看错了，而你只剩一页。",
        "body": "你写东西是为了赢。rebuttal 是你的主场——客气、逐条、赶尽杀绝。正文里明明已经输掉的仗，你在回复里赢回来过。",
        "best": "reject 被你翻成 accept。",
        "worst": "你跟导师也这么吵，而且也赢了。"
      },
      "framing": {
        "name": "讲故事",
        "tag": "重点从来不是那个数。",
        "body": "你知道结果不会自己说话。同一个实验，是脚注还是标题，全看前面那句话怎么写——而那句话是你写的。",
        "best": "所有人都听懂了这个工作为什么值得做。",
        "worst": "你也听懂了，直到有人问你那个数到底是多少。"
      },
      "hypothesis": {
        "name": "吹哨人",
        "tag": "会不会整个领域从一开始就错了。",
        "body": "你不是来涨半个点的。你是因为主流那套说法有个地方对不上，而你宁可去追那个地方，也不愿意再打磨任何现成的东西。",
        "best": "别人路过都没看见的问题，被你捡到了。",
        "worst": "这种想法你攒了十一个，一作一篇没有。"
      },
      "error-analysis": {
        "name": "错题本",
        "tag": "挂掉的那些才是论文。",
        "body": "别人看均值，你看长尾。盯着那十二个错的样例，你挖出来的真 bug 比琢磨跑对的那些多得多。",
        "best": "你说得清自己的方法什么时候会崩，这基本上就等于说得清它为什么能行。",
        "worst": "你现在看见榜单的第一反应是：这榜是不是坏了。"
      },
      "scope-control": {
        "name": "见好就收",
        "tag": "不做。那是另一篇的事。",
        "body": "整栋楼最稀缺的一项本事。ddl 前三周冒出来一个真的很香的 idea，你能看一眼，然后放手。这条走廊上没几个人做得到。",
        "best": "你每次都投得出去，而且是完整的那种。",
        "worst": "你放掉的那几个里，有一个后来被别人做成了 oral。"
      },
      "three-am-idea": {
        "name": "托梦",
        "tag": "祖师爷托梦，还不给引用。",
        "body": "你最好的东西从来不是坐在工位上想出来的。洗澡的时候、走回宿舍的路上、睡着前那九十秒——所以你床头常年放着一个能写字的东西。",
        "best": "那个想法是真新的，天亮前你还能把它证出来。",
        "worst": "早上九点回看，是你自己的字，但完全看不懂在说什么。"
      },
      "co-authorship": {
        "name": "读空气",
        "tag": "他没说出口的那句，你听见了。",
        "body": "你会读空气。哪个 co-author 心里已经放弃这个项目了，哪个是真的忙崩了，哪个其实只是在等你直接问他一句——你都清楚。",
        "best": "你的项目做得完，因为组里的人还愿意互相说话。",
        "worst": "所有人的焦虑你都接住了，然后全记在自己账上。"
      },
      "corresponding-author": {
        "name": "通讯作者",
        "tag": "总得有人签这个字。",
        "body": "你不等谁来安排。会是你约的，时间是你定的，那封谁都不想发的邮件是你发的，最后印在第一页上的邮箱也是你的。",
        "best": "这个项目有主心骨。",
        "worst": "你一个人干四个人的活，还觉得这叫锻炼。"
      },
      "lab-morale": {
        "name": "气氛组",
        "tag": "组群是承重墙。",
        "body": "读博是一种集体症状，只有你会把这句话说出来。谁生日、谁哪天被拒，你都记得。有两个师弟没退学是因为你。",
        "best": "你们组没有人是一个人熬过那个月的。",
        "worst": "全组的心态你都照顾到了，除了你自己那篇毕业论文。"
      },
      "positioning": {
        "name": "拿捏",
        "tag": "你没开口要。你让他自己想到。",
        "body": "你清楚一件事到底是怎么定下来的。你知道哪句话能说动导师，也知道要按什么顺序说，他才听得进去。",
        "best": "卡、名额、合作，最后都到你手上。",
        "worst": "你开始对朋友也这么来了。"
      },
      "deadline-stamina": {
        "name": "DDL 战神",
        "tag": "七十二小时。又不是没熬过。",
        "body": "你的论文从来不是写出来的，是最后一周肝出来的，这事你几年前就认了。你不比谁快，你只是不停。",
        "best": "东西是完整交上去的，不是凑上去的。",
        "worst": "那几天欠的，身体记着，三月才跟你算账。"
      },
      "rejection-tolerance": {
        "name": "钝感力",
        "tag": "Desk reject。行，下一个会。",
        "body": "分数回来的时候，你身上有个地方就是不碎。四个会拒过你，邮件当天你照样点得开——这也算一种力气，只是简历上写不了。",
        "best": "你还在投。说到底，也只有一直投这条路走得通。",
        "worst": "你已经不觉得难受了。不是不难受，是麻了。"
      },
      "cluster-wrangling": {
        "name": "抢卡",
        "tag": "抢不到卡，剩下的都别谈。",
        "body": "你跟机器是有交情的。哪台节点跑着跑着就发烫、哪台报的空闲显存是假的、周日凌晨四点怎么把两百张卡攥住不撒手，你比谁都门儿清。",
        "best": "卡这一环，从来卡不到你。",
        "worst": "连着十一天，你修的全是环境和调度，一个科研问题都没碰。"
      },
      "caffeine": {
        "name": "咖啡续命",
        "tag": "你能干活的那几个小时，是买来的。",
        "body": "你按化学品排班，而且你不装。第四杯不是段子，是方法论里承重的一环。",
        "best": "晚上十一点到凌晨三点，你是真的好用。",
        "worst": "你早就不知道自己原装是什么状态了——你的 baseline 没了。"
      },
      "field-sense": {
