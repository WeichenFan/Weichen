

:root{--hue:var(--voice-enc)}


.wordmark{display:flex;flex-direction:column;gap:2px}
.wordmark__gloss{
  font:500 var(--t-cap-xs)/var(--lh-cap-xs) var(--mono);
  letter-spacing:var(--tr-cap-xs);word-spacing:.08em;text-transform:uppercase;
  color:var(--ink-muted);
}


.rail__title{
  font:500 var(--t-cap)/1.5 var(--mono);
  letter-spacing:var(--tr-cap);word-spacing:.08em;text-transform:uppercase;
  color:var(--ink-muted);
}


.langbar{
  display:flex;align-items:baseline;gap:var(--s3);
  margin-left:auto;
  margin-right:max(0px,calc(100% - var(--band)));  
}
.lang{
  font:500 var(--t-cap-xs)/var(--lh-cap-xs) var(--mono);
  letter-spacing:var(--tr-cap-xs);word-spacing:.08em;text-transform:uppercase;
  color:var(--ink-muted);
  padding:6px 0;cursor:pointer;white-space:nowrap;
}
.lang:hover,.lang:focus-visible{color:var(--ink);text-decoration:underline;
  text-decoration-style:dotted;text-underline-offset:4px}

.lang[aria-pressed="true"]{
  color:var(--ink);
  text-decoration:underline;text-decoration-style:solid;text-underline-offset:4px;
}


html[lang^="zh"]{
  --mono:'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,
         'PingFang SC','PingFang TC','Hiragino Sans GB','Microsoft YaHei',
         'Noto Sans CJK SC','Source Han Sans SC',sans-serif;
  --serif:'Newsreader','Iowan Old Style',Georgia,
          'Songti SC','Songti TC','SimSun','Noto Serif CJK SC',
          'Source Han Serif SC',serif;
}

html[lang="zh-Hant"]{
  --mono:'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,
         'PingFang TC','Heiti TC','Microsoft JhengHei',
         'Noto Sans CJK TC','Source Han Sans TC',sans-serif;
  --serif:'Newsreader','Iowan Old Style',Georgia,
          'Songti TC','PMingLiU','Noto Serif CJK TC',
          'Source Han Serif TC',serif;
}

html[lang^="zh"] .quiz__lede,
html[lang^="zh"] .result__prose,
html[lang^="zh"] .answer{line-height:1.75}
html[lang^="zh"] .quiz__q{line-height:1.5}


html[lang^="zh"] .result__tag{
  font-style:normal;
  letter-spacing:.04em;
}

.quiz__title{
  font:400 var(--t-word)/1.12 var(--serif);
  font-variation-settings:'opsz' 32;
  letter-spacing:-.01em;text-wrap:balance;
  color:var(--ink);
  margin-bottom:var(--s5);
}


.quiz__card{
  border:var(--card-border);
  box-shadow:var(--card-shadow);
  background:var(--paper-inset);
  padding:var(--s6) var(--s5);
  min-height:404px;
  display:flex;flex-direction:column;
}
#stage:focus{outline:none}

.quiz__kicker{
  font:500 var(--t-cap-xs)/var(--lh-cap-xs) var(--mono);
  letter-spacing:var(--tr-cap-xs);word-spacing:.08em;text-transform:uppercase;
  color:var(--hue);
  margin-bottom:var(--s4);
}
.quiz__lede{
  font:400 var(--t-body)/var(--lh-body) var(--mono);
  color:var(--ink);max-width:56ch;
}

.attrs{list-style:none;margin-top:var(--s6);display:grid;gap:var(--s3);
       grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}
.attrs__item{border-left:2px solid var(--hue);padding-left:var(--s3)}
.attrs__name{
  display:block;
  font:500 var(--t-cap)/var(--lh-cap) var(--mono);
  letter-spacing:var(--tr-cap);word-spacing:.08em;text-transform:uppercase;
  color:var(--hue);
}
.attrs__line{
  display:block;margin-top:2px;
  font:400 var(--t-meta)/var(--lh-meta) var(--mono);
  color:var(--ink-muted);text-wrap:pretty;
}

.quiz__count{
  font:500 var(--t-cap-xs)/var(--lh-cap-xs) var(--mono);
  letter-spacing:var(--tr-cap-xs);text-transform:uppercase;
  font-variant-numeric:tabular-nums slashed-zero;
  color:var(--ink-muted);margin-bottom:var(--s2);
}
.quiz__q{
  font:500 var(--t-title)/var(--lh-title) var(--serif);
  font-variation-settings:'opsz' 24;
  letter-spacing:-.005em;text-wrap:pretty;color:var(--ink);
  margin-bottom:var(--s5);max-width:52ch;
}
.quiz__q:focus{outline:none}


.quiz__progress{display:flex;gap:var(--s2);margin-bottom:var(--s4)}
.pip{
  width:var(--bullet);height:var(--bullet);
  background:transparent;
  box-shadow:inset 0 0 0 1px var(--rule-strong);
}
.pip.is-done{background:var(--shadow);box-shadow:none}
.pip.is-here{background:var(--ink);box-shadow:none}


.quiz__answers{list-style:none;display:flex;flex-direction:column;gap:var(--s3);margin-top:auto}
.answer{
  display:flex;align-items:flex-start;gap:var(--s3);
  width:100%;text-align:left;
  padding:var(--s3) var(--s4);
  border:2px solid var(--rule-hair);
  background:transparent;
  color:var(--ink);
  font:400 var(--t-body)/var(--lh-body) var(--mono);
  cursor:pointer;
}
.answer:hover,.answer:focus-visible{
  border-color:var(--ink);
  background:var(--bone-card);
  box-shadow:var(--card-shadow);
  transform:translate(-2px,-2px);
  transition:transform var(--d-snap) linear,box-shadow var(--d-snap) linear,
             background-color var(--d-snap) linear,border-color var(--d-snap) linear;
}

.answer__key{
  flex:none;
  font:500 var(--t-cap)/var(--lh-cap) var(--mono);
  letter-spacing:0;
  color:var(--ink-muted);
  border:1px solid var(--rule-hair);
  width:22px;height:22px;
  display:flex;align-items:center;justify-content:center;
}
.answer:hover .answer__key,.answer:focus-visible .answer__key{color:var(--ink);border-color:var(--ink)}
.answer__text{text-wrap:pretty}

.quiz__go,.quiz__back{
  align-self:flex-start;
  font:400 var(--t-link)/var(--lh-link) var(--mono);
  padding:4px 0;color:var(--ink);
  text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px;
  cursor:pointer;
}
.quiz__go{margin-top:var(--s5);font-size:var(--t-body)}
.quiz__back{margin-top:var(--s4);color:var(--ink-muted)}
.quiz__go:hover,.quiz__back:hover,
.quiz__go:focus-visible,.quiz__back:focus-visible{text-decoration-thickness:2px;color:var(--ink)}


.quiz__card--result{display:block}

.portraitcard{
  float:left;
  width:180px;
  margin:0 var(--s5) var(--s4) 0;
  border:var(--card-border);
  border-color:var(--hue);
  background:var(--mat);
  box-shadow:var(--plate-shadow);
}
.portraitcard__img{
  display:block;width:100%;height:auto;
  aspect-ratio:3/4;object-fit:cover;
}

.portraitcard__name{
  font:500 var(--t-cap)/var(--lh-cap) var(--mono);
  letter-spacing:var(--tr-cap);word-spacing:.08em;text-transform:uppercase;
  text-align:center;color:var(--hue);
  background:var(--paper-inset);
  padding:var(--s2) var(--s1);
  border-top:1px solid var(--hue);
  text-wrap:balance;
}

.result__tag{
  font:500 var(--t-voice)/var(--lh-voice) var(--serif);
  font-style:italic;color:var(--hue);
  text-wrap:pretty;margin-bottom:var(--s3);
}
.result__prose{
  font:400 var(--t-body)/var(--lh-body) var(--mono);
  color:var(--ink);text-wrap:pretty;
}

.result__poles{
  display:grid;grid-template-columns:auto minmax(0,1fr);
  column-gap:var(--s4);row-gap:var(--s2);
  margin-top:var(--s4);
  font:400 var(--t-meta)/var(--lh-meta) var(--mono);
}
.result__poles dt{
  font-weight:500;text-transform:uppercase;
  letter-spacing:var(--tr-cap-xs);font-size:var(--t-cap-xs);
  color:var(--ink-muted);white-space:nowrap;padding-top:3px;
}
.result__poles dd{color:var(--ink);text-wrap:pretty}

.dimbars{clear:both;margin-top:var(--s6);padding-top:var(--s4);border-top:var(--hair)}
.dimbars__label{
  font:500 var(--t-cap-xs)/var(--lh-cap-xs) var(--mono);
  letter-spacing:var(--tr-cap-xs);text-transform:uppercase;
  color:var(--ink-muted);margin-bottom:var(--s3);
}
.dimbar{
  display:grid;grid-template-columns:110px minmax(0,1fr) 34px;
  align-items:center;gap:var(--s3);
  font:400 var(--t-meta)/var(--lh-meta) var(--mono);
  font-variant-numeric:tabular-nums slashed-zero;
  color:var(--ink-muted);
  padding:3px 0;
}
.dimbar.is-winner{color:var(--ink)}
.dimbar__name{text-transform:uppercase;letter-spacing:var(--tr-cap-xs);font-size:var(--t-cap-xs)}
.dimbar__track{display:block;height:7px;background:var(--paper-inset);border:1px solid var(--rule-hair)}
.dimbar__fill{display:block;height:100%;width:var(--w,0%);background:var(--hue);transform-origin:left center}
.dimbar__num{text-align:right}


@media (prefers-reduced-motion:no-preference){
  @keyframes bar-draw{from{transform:scaleX(0)}to{transform:scaleX(1)}}
  .dimbar__fill{animation:bar-draw 520ms var(--ease-out) both}
}

.quiz__note{
  font:400 var(--t-cap)/var(--lh-cap) var(--mono);
  letter-spacing:0;word-spacing:normal;text-transform:none;
  color:var(--ink-muted);
  margin-top:var(--s7);padding-top:var(--s3);
  border-top:var(--hair);
  max-width:58ch;text-wrap:pretty;
}


@media (max-width:759px){
  .rail__title{display:none}
  .quiz__card{padding:var(--s5) var(--s4);min-height:0}
}
@media (max-width:559px){
  
  .portraitcard{float:none;width:160px;margin:0 0 var(--s4) 0}
  .result__poles{grid-template-columns:minmax(0,1fr);row-gap:2px}
  .result__poles dd{margin-bottom:var(--s2)}
  .dimbar{grid-template-columns:88px minmax(0,1fr) 28px;gap:var(--s2)}
  .answer{padding:var(--s3)}
}


html[data-voice="off"] .quiz__note,
html[data-voice="off"] .rail__title{display:none}


@media (prefers-contrast:more){
  .answer{border-color:var(--ink)}
  .pip{box-shadow:inset 0 0 0 1px var(--ink)}
  .dimbar__track{border-color:var(--ink)}
}
@media (forced-colors:active){
  :root{--hue:CanvasText}
  .quiz__card,.answer,.portraitcard{border-color:CanvasText;box-shadow:none}
  .answer:hover,.answer:focus-visible{border-color:Highlight;transform:none}
  .pip{box-shadow:inset 0 0 0 1px CanvasText}
  .pip.is-done,.pip.is-here{background:CanvasText}
  .dimbar__track{border-color:CanvasText}
  .dimbar__fill{background:CanvasText}
  .portraitcard__name{color:CanvasText;border-top-color:CanvasText}
}


@media print{
  .quiz__answers,.quiz__progress,.quiz__go,.quiz__back,.quiz__note,
  .masthead__nav,.skip{display:none!important}
  .quiz__card{border:1px solid #000;box-shadow:none;min-height:0;background:#fff}
  .portraitcard{border:1px solid #000;box-shadow:none;background:#fff}
  .portraitcard__name,.result__tag,.quiz__kicker{color:#000}
  .dimbar__fill{background:#000;animation:none}
}
